[Desktop Entry]
Type=Application
Name=DeepSeek Harness
Exec=/usr/bin/harbour-dshq
Icon=harbour-dshq
X-Nemo-Application-Type=silica-qt5

[X-Sailjail]
# Sandboxing=Disabled: the app must reach the systemd user instance and
# local binaries directly (sailjail's --private-bin hides systemctl,
# and custom dbus tokens are not supported by sailjaild).
Sandboxing=Disabled
